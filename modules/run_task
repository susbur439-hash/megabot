import time
import copy
import random

from modules.analysis import analysis
from modules.decision import decision
from modules.execution import execution
from modules.goals import set_goal, update_goal
from modules.system_guard import system_guard
from modules.self_improver import self_improver
from modules.doctor import doctor
from modules.control_layer import ControlLayer
from modules.task_core import extract_task, normalize_task

try:
    from modules.system_observer import run as observer_run
except:
    observer_run = None


control_layer = ControlLayer()


def run_task(data):
    data.setdefault("log", [])

    task = normalize_task(extract_task(data))
    data["task"] = task

    data["last_layer"] = "start"
    data = doctor(data)

    data["last_layer"] = "goal"
    data = set_goal(data)

    data["last_layer"] = "analysis"
    data = analysis(data)

    data["last_layer"] = "decision"
    data = decision(data)

    data = self_improver(data)

    # =========================
    # 🚨 FIX: НЕ ПЕРЕЗАТИРАЕМ decision
    # =========================
    final_decision = data.get("decision", "create_module")
    best = data.get("best_module")

    # =========================
    # 🧠 SMART OVERRIDE (НО НЕ ЛОМАЕТ decision)
    # =========================
    if final_decision == "run_module" and not best:
        final_decision = "create_module"

    data["decision"] = final_decision
    data["last_decision"] = final_decision

    # =========================
    # 🛑 CONTROL
    # =========================
    decision_result = control_layer.filter_decision(final_decision)

    if not decision_result["allowed"]:
        final_decision = decision_result["forced_decision"]
        data["decision"] = final_decision
        data["log"].append("🛑 CONTROL OVERRIDE → " + final_decision)

    # =========================
    # 🚀 EXECUTION
    # =========================
    data["last_layer"] = "execution"
    data = execution(data)

    data = system_guard(data)

    data["last_layer"] = "goal_update"
    data = update_goal(data)

    data = analysis(data)

    score = data.get("evaluation", {}).get("score", 0)
    delta = data.get("evaluation", {}).get("delta", 0)

    # =========================
    # 🧠 STRATEGY
    # =========================
    if delta <= 0:
        strategy = "explore"
    elif score >= 80:
        strategy = "exploit"
    elif score >= 50:
        strategy = "optimize"
    else:
        strategy = "explore"

    data["strategy"] = strategy

    # =========================
    # 🔥 FINAL DECISION (FIXED LOGIC)
    # =========================
    if strategy == "exploit" and best:
        data["decision"] = "run_module"
        data["module"] = best
    elif strategy == "optimize" and best:
        data["decision"] = "improve_module"
        data["module"] = best
    else:
        data["decision"] = "create_module"
        data["module"] = None

    # =========================
    # 🧨 LOOP BREAKER
    # =========================
    if data.get("decision") == data.get("prev_decision"):
        data["repeat_count"] = data.get("repeat_count", 0) + 1
    else:
        data["repeat_count"] = 0

    if data["repeat_count"] >= 3:
        data["decision"] = "create_module"
        data["module"] = None
        data["repeat_count"] = 0
        data["log"].append("🧨 LOOP BREAKER ACTIVATED")

    data["prev_decision"] = data["decision"]

    data["log"] = data["log"][-200:]

    return data
