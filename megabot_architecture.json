{
  "version": "10.1",

  "core_loop": [
    "task",
    "task_interpreter",
    "state_manager",
    "analysis",
    "planning",
    "decision",
    "action",
    "execution",
    "evaluation",
    "learning",
    "control_layer",
    "goal_update",
    "loop"
  ],

  "layers": {
    "input": ["task_interpreter"],
    "state": ["state_manager"],

    "analysis": ["analysis"],
    "planning": ["planning"],
    "decision": ["decision"],
    "action": ["action"],

    "execution": ["execution"],
    "evaluation": ["evaluation"],

    "learning": ["learning", "self_improver"],

    "control": ["system_guard", "control_layer"],

    "goal": ["goals"],
    "loop": ["director"]
  },

  "required_modules": [
    "task_interpreter",
    "state_manager",

    "analysis",
    "planning",
    "decision",
    "action",

    "execution",
    "evaluation",

    "learning",
    "self_improver",

    "system_guard",
    "control_layer",

    "goals",
    "director"
  ],

  "rules": {
    "must_follow_loop": true,
    "must_learn": true,
    "must_use_experience": true,
    "must_update_goal": true,
    "no_random_behavior": true
  },

  "goals": {
    "type": "adaptive",
    "progress_required": true,
    "no_stagnation": true
  },

  "control": {
    "allow_autofix": true,
    "allow_module_creation": true,
    "allow_module_improvement": true
  }
}
